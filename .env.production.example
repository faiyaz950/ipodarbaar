# Production template for BigRock (cPanel). Copy to .env on the server and fill in the blanks.
# Never commit the real .env.

APP_NAME="IPO Darbaar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.in
# Old/alternate hostnames that 301-redirect to APP_URL (comma separated)
REDIRECT_HOSTS=www.your-domain.in
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Only for Option B in DEPLOY-BIGROCK.md (public_html is a folder, not a symlink)
# APP_PUBLIC_PATH=/home/username/public_html

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Databases (names are prefixed with your cPanel username)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=username_ipodarbar
DB_USERNAME=username_ipodarbar
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# cPanel → Email Accounts (create e.g. noreply@your-domain.in)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.your-domain.in
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.in"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOURLY_LIMIT=250

# Data sources
IPO_API_URL=https://www.finowings.com/ipo-sync.php
IPO_API_KEY=
# If this server can't reach the IPO API, relay it via .github/workflows/ipo-relay.yml:
# IPO_API_PULL=false
# IPO_PUSH_TOKEN=
NEWS_API_URL=https://courses.finowings.com/api/market-news-list

# Telegram channel auto-posts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# Optional defaults (these can also be set in Admin → Settings)
ADS_ENABLED=false
ADSENSE_CLIENT=
GA4_MEASUREMENT_ID=
CF_ANALYTICS_TOKEN=

# SEO: IndexNow key (any 8-128 letters/digits), search console verification (also in Admin → Settings)
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SOCIAL_TELEGRAM_URL=
SOCIAL_WHATSAPP_URL=
